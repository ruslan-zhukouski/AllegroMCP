{
  "servers": {
    "AllegroMCPServer": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "ALLEGRO_CLIENT_ID",
        "-e",
        "ALLEGRO_CLIENT_SECRET",
        "--mount",
        "type=volume,src=allegromcp,target=/home/app",
        "ruslanzhukouski/allegromcp"
      ]
    }
  }
}